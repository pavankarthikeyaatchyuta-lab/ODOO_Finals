# Server only. NEVER prefix these with VITE_. Runtime role, pooled connection:
DATABASE_URL=postgresql://rk_backend.PROJECT:PASSWORD@POOLER:6543/postgres?schema=app&pgbouncer=true&connection_limit=3
# Migration owner, direct connection or session pooler; never used by request handlers:
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:5432/postgres?schema=app
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-server-only
ALLOWED_ORIGINS=http://localhost:5173
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
PORT=3001
# Used ONLY by db:provision, not runtime:
BACKEND_DB_PASSWORD=replace-with-generated-password
DOCUMENT_BUCKET=wedding-documents
