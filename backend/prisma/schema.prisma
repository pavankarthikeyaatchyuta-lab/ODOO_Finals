generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  FOUNDER
  PLANNER
  COORDINATOR
  FINANCE
  CLIENT
}

enum PackageType {
  FULL_SERVICE
  PARTIAL_DAY_OF
}

enum EnquiryStage {
  NEW
  CONTACTED
  CONSULTATION_SCHEDULED
  PROPOSAL_SENT
  LOST
}

enum WeddingState {
  ENQUIRY
  PROPOSAL
  AGREEMENT
  BOOKING_CONFIRMED
  PLANNING
  EXECUTION
  COMPLETED
  CANCELLED
}

enum ConsultationState {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model UserProfile {
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String
  role        Role
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  client      Client?
  assignments WeddingAssignment[]
  bookings    Consultation[] @relation("Planner")
  ownedTasks  WeddingTask[]
  enquiries   Enquiry[]
  timelineEvents TimelineEvent[]
  arrivals    VendorArrival[]
  incidents   Incident[]
  notifications ScheduleNotification[]
  labourRates LabourRate[]
  labourEntries LabourEntry[]
}

model Client {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String   @unique
  phone       String?
  requirements String?
  userId      String?  @unique @db.Uuid
  archivedAt  DateTime? @db.Timestamptz(3)
  user        UserProfile? @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  weddings    WeddingClient[]
}

model Wedding {
  id            String       @id @default(uuid()) @db.Uuid
  title         String
  weddingDate   DateTime?     @db.Date
  packageType   PackageType
  state         WeddingState @default(ENQUIRY)
  guestCount    Int?
  preferredTheme String?
  coupleDetails String?
  location      String?
  requirements  String?
  currency      String @default("INR") @db.VarChar(3)
  proposalStatus ProposalStatus @default(DRAFT)
  proposalConfirmedAt DateTime? @db.Timestamptz(3)
  proposalConfirmedBy String? @db.Uuid
  bookingDepositRequired Decimal? @db.Decimal(16, 2)
  timezone      String @default("Asia/Kolkata")
  scheduleVersion Int @default(1)
  independentScheduleApproval Boolean @default(true)
  budgetMax     Decimal?     @db.Decimal(16, 2)
  internalNotes String?
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  clients       WeddingClient[]
  assignments   WeddingAssignment[]
  enquiry       Enquiry?
  consultations Consultation[]
  functions     WeddingFunction[]
  agreement     Agreement?
  documents     Document[]
  quotationRounds QuotationRound[]
  vendors       WeddingVendor[]
  bookingPayments BookingPayment[]
  financeSettings FinanceSettings?
  expenses AdditionalExpense[]
  vendorBills VendorBill[]
  recognitions RevenueRecognition[]
  milestones ClientMilestone[]
  labourEntries LabourEntry[]
  taskGeneration TaskGeneration?
  tasks         WeddingTask[]
  timelineEvents TimelineEvent[]
  arrivals      VendorArrival[]
  incidents     Incident[]
  scheduleChanges ScheduleChange[]
  notifications ScheduleNotification[]
  @@index([state, createdAt])
}

enum WeddingFunctionType {
  MEHENDI
  SANGEET
  RECEPTION
}

model WeddingFunction {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  type        WeddingFunctionType
  name        String
  startAt     DateTime? @db.Timestamptz(3)
  endAt       DateTime? @db.Timestamptz(3)
  venue       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  tasks       WeddingTask[]
  timelineEvents TimelineEvent[]
  arrivals      VendorArrival[]
  @@unique([weddingId, name])
  @@unique([id, weddingId])
}

model WeddingClient {
  weddingId String @db.Uuid
  clientId  String @db.Uuid
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  client    Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  @@id([weddingId, clientId])
  @@index([clientId])
}

model WeddingAssignment {
  weddingId String @db.Uuid
  userId    String @db.Uuid
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([weddingId, userId])
  @@index([userId])
}

model Enquiry {
  id            String @id @default(uuid()) @db.Uuid
  weddingId     String @unique @db.Uuid
  wedding       Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  stage         EnquiryStage @default(NEW)
  source        String?
  followUpStatus FollowUpStatus @default(PENDING)
  followUpAt    DateTime? @db.Timestamptz(3)
  assignedToId  String? @db.Uuid
  assignedTo    UserProfile? @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  internalNotes String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  @@index([stage, createdAt])
  @@index([assignedToId])
}

enum FollowUpStatus {
  PENDING
  CONTACTED
  FOLLOW_UP_DUE
  CLOSED
}

enum ProposalStatus {
  DRAFT
  CONFIRMED
}

enum AgreementStatus {
  DRAFT
  SENT
  SIGNATURE_SUBMITTED
  SIGNED
}

enum DocumentKind {
  AGREEMENT
  SIGNED_AGREEMENT
  FLOOR_PLAN
  PAYMENT_EVIDENCE
  EXPENSE_EVIDENCE
  VENDOR_BILL
}

enum DocumentStatus {
  PENDING
  VERIFIED
}

model Document {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  kind        DocumentKind
  status      DocumentStatus @default(PENDING)
  storagePath String @unique
  fileName    String
  contentType String
  size        Int
  sha256      String?
  uploadedBy  String @db.Uuid
  verifiedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  agreements  Agreement[] @relation("AgreementDocument")
  signatures  Agreement[] @relation("SignatureDocument")
  payments    BookingPayment[]
  expenses AdditionalExpense[]
  bills VendorBill[]
  @@index([weddingId, kind])
}

model Agreement {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @unique @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  title       String
  terms       String
  version     Int @default(1)
  status      AgreementStatus @default(DRAFT)
  documentId  String? @db.Uuid
  document    Document? @relation("AgreementDocument", fields: [documentId], references: [id], onDelete: Restrict)
  signedDocumentId String? @db.Uuid
  signedDocument Document? @relation("SignatureDocument", fields: [signedDocumentId], references: [id], onDelete: Restrict)
  sentAt      DateTime? @db.Timestamptz(3)
  claimedSignedAt DateTime? @db.Timestamptz(3)
  signedAt    DateTime? @db.Timestamptz(3)
  verifiedBy  String? @db.Uuid
  verifiedAt  DateTime? @db.Timestamptz(3)
  reviewNote  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model VendorCategory {
  code        String @id
  name        String @unique
  vendors     Vendor[]
  rounds      QuotationRound[]
  selections  WeddingVendor[]
}

model Vendor {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  categoryCode String
  category    VendorCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  contactName String
  email       String @unique
  phone       String
  serviceDetails String
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  requests    QuotationRequest[]
  weddings    WeddingVendor[]
  notifications ScheduleNotification[]
  @@index([categoryCode, name])
}

enum QuotationRoundStatus {
  OPEN
  SELECTED
}

enum QuotationRequestStatus {
  REQUESTED
  SUBMITTED
  SELECTED
  CLOSED
}

model QuotationRound {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  categoryCode String
  category    VendorCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  currency    String @db.VarChar(3)
  status      QuotationRoundStatus @default(OPEN)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  requests    QuotationRequest[]
  @@unique([weddingId, categoryCode])
}

model QuotationRequest {
  id          String @id @default(uuid()) @db.Uuid
  roundId     String @db.Uuid
  round       QuotationRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  vendorId    String @db.Uuid
  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status      QuotationRequestStatus @default(REQUESTED)
  closedAt    DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  quotation   Quotation?
  @@unique([roundId, vendorId])
}

model Quotation {
  id          String @id @default(uuid()) @db.Uuid
  requestId   String @unique @db.Uuid
  request     QuotationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  pricePerPlate Decimal @db.Decimal(16, 2)
  guestCount  Int
  additionalHourRate Decimal @db.Decimal(16, 2)
  additionalHours Decimal @db.Decimal(8, 2)
  menuDetails String
  inclusions  String[]
  exclusions  String[]
  total       Decimal @db.Decimal(16, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  items       QuotationItem[]
  selection   WeddingVendor?
}

model QuotationItem {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(16, 2)
  total       Decimal @db.Decimal(16, 2)
  @@index([quotationId])
}

model WeddingVendor {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  vendorId    String @db.Uuid
  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  categoryCode String
  category    VendorCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  quotationId String? @unique @db.Uuid
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  source      String @default("QUOTATION")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  eventLinks  EventVendor[]
  arrivals    VendorArrival[]
  payments BookingPayment[]
  expenses AdditionalExpense[]
  bill VendorBill?
  manualContractAmount Decimal? @db.Decimal(16, 2)
  contractApprovedBy String? @db.Uuid
  contractApprovedAt DateTime? @db.Timestamptz(3)
  contractNote String?
  @@unique([id, weddingId])
  @@unique([weddingId, categoryCode])
  @@index([vendorId])
  @@unique([weddingId, vendorId])
}

enum TimelineStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model TimelineEvent {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  functionId  String? @db.Uuid
  function    WeddingFunction? @relation(fields: [functionId, weddingId], references: [id, weddingId], onDelete: Restrict)
  title       String
  plannedStart DateTime @db.Timestamptz(3)
  plannedEnd  DateTime @db.Timestamptz(3)
  actualStart DateTime? @db.Timestamptz(3)
  actualEnd   DateTime? @db.Timestamptz(3)
  ownerId     String? @db.Uuid
  owner       UserProfile? @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  status      TimelineStatus @default(PLANNED)
  version     Int @default(1)
  vendors     EventVendor[]
  dependencies EventDependency[] @relation("EventDependencies")
  dependents  EventDependency[] @relation("DependentEvents")
  changes     ScheduleChange[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  @@unique([id, weddingId])
  @@index([weddingId, plannedStart])
  @@index([ownerId])
}

model EventVendor {
  eventId     String @db.Uuid
  weddingId   String @db.Uuid
  vendorId    String @db.Uuid
  event       TimelineEvent @relation(fields: [eventId, weddingId], references: [id, weddingId], onDelete: Restrict)
  association WeddingVendor @relation(fields: [weddingId, vendorId], references: [weddingId, vendorId], onDelete: Restrict)
  @@id([eventId, vendorId])
  @@index([weddingId, vendorId])
}

model EventDependency {
  eventId     String @db.Uuid
  dependsOnId String @db.Uuid
  weddingId   String @db.Uuid
  event       TimelineEvent @relation("EventDependencies", fields: [eventId, weddingId], references: [id, weddingId], onDelete: Restrict)
  predecessor TimelineEvent @relation("DependentEvents", fields: [dependsOnId, weddingId], references: [id, weddingId], onDelete: Restrict)
  @@id([eventId, dependsOnId])
  @@index([dependsOnId, weddingId])
}

model VendorArrival {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  vendorId    String @db.Uuid
  association WeddingVendor @relation(fields: [weddingId, vendorId], references: [weddingId, vendorId], onDelete: Restrict)
  functionId  String? @db.Uuid
  function    WeddingFunction? @relation(fields: [functionId, weddingId], references: [id, weddingId], onDelete: Restrict)
  expectedAt  DateTime @db.Timestamptz(3)
  actualAt    DateTime? @db.Timestamptz(3)
  confirmedBy String? @db.Uuid
  confirmedAt DateTime? @db.Timestamptz(3)
  coordinatorId String? @db.Uuid
  coordinator UserProfile? @relation(fields: [coordinatorId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@unique([weddingId, vendorId, expectedAt])
  @@index([coordinatorId])
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Incident {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  category    String
  severity    IncidentSeverity
  description String
  ownerId     String? @db.Uuid
  owner       UserProfile? @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  deadline    DateTime? @db.Timestamptz(3)
  status      IncidentStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime? @db.Timestamptz(3)
  version     Int @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  @@index([weddingId, status])
  @@index([ownerId])
}

enum ScheduleChangeStatus {
  PROPOSED
  APPROVED
  REJECTED
  PUBLISHED
}

model ScheduleChange {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  eventId     String @db.Uuid
  event       TimelineEvent @relation(fields: [eventId, weddingId], references: [id, weddingId], onDelete: Restrict)
  baseScheduleVersion Int
  previousStart DateTime @db.Timestamptz(3)
  previousEnd DateTime @db.Timestamptz(3)
  proposedStart DateTime @db.Timestamptz(3)
  proposedEnd DateTime @db.Timestamptz(3)
  reason      String
  impacts     Json
  requestedBy String @db.Uuid
  status      ScheduleChangeStatus @default(PROPOSED)
  approvedBy  String? @db.Uuid
  approvedAt  DateTime? @db.Timestamptz(3)
  decidedBy   String? @db.Uuid
  decidedAt   DateTime? @db.Timestamptz(3)
  decisionNote String?
  publishedAt DateTime? @db.Timestamptz(3)
  publishedVersion Int?
  notifications ScheduleNotification[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@index([weddingId, createdAt])
  @@unique([id, weddingId])
}

enum AcknowledgementStatus {
  SENT
  ACKNOWLEDGED
  PROBLEM
}

model ScheduleNotification {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  changeId    String @db.Uuid
  change      ScheduleChange @relation(fields: [changeId, weddingId], references: [id, weddingId], onDelete: Restrict)
  vendorId    String? @db.Uuid
  vendor      Vendor? @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  userId      String? @db.Uuid
  user        UserProfile? @relation(fields: [userId], references: [id], onDelete: Restrict)
  instructionVersion Int
  instructions Json
  deliveryStatus String @default("AVAILABLE_IN_APP")
  status      AcknowledgementStatus @default(SENT)
  sentAt      DateTime @default(now()) @db.Timestamptz(3)
  acknowledgedAt DateTime? @db.Timestamptz(3)
  problemDescription String?
  tokenHash   String? @unique
  tokenExpiresAt DateTime? @db.Timestamptz(3)
  @@unique([changeId, vendorId])
  @@unique([changeId, userId])
  @@index([weddingId, status])
  @@index([changeId, weddingId])
}

enum BookingPaymentStatus {
  CLAIMED
  VERIFIED
  REJECTED
  INITIATED
  FAILED
  REVERSED
}

enum PaymentDirection {
  CLIENT_RECEIPT
  VENDOR_DISBURSEMENT
}

enum PaymentMilestone {
  BOOKING
  ADVANCE
  FINAL
}

model BookingPayment {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  amount      Decimal @db.Decimal(16, 2)
  currency    String @db.VarChar(3)
  reference   String @unique
  status      BookingPaymentStatus @default(CLAIMED)
  direction PaymentDirection @default(CLIENT_RECEIPT)
  milestone PaymentMilestone @default(BOOKING)
  weddingVendorId String? @db.Uuid
  weddingVendor WeddingVendor? @relation(fields: [weddingVendorId, weddingId], references: [id, weddingId], onDelete: Restrict)
  isDemo Boolean @default(false)
  verificationMethod String?
  reversedBy String? @db.Uuid
  reversedAt DateTime? @db.Timestamptz(3)
  reversalNote String?
  evidenceDocumentId String? @db.Uuid
  evidenceDocument Document? @relation(fields: [evidenceDocumentId], references: [id], onDelete: Restrict)
  claimedBy   String @db.Uuid
  reviewedBy  String? @db.Uuid
  reviewedAt  DateTime? @db.Timestamptz(3)
  reviewNote  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@index([weddingId, status])
  @@index([weddingVendorId, weddingId])
}

model FinanceSettings {
  weddingId String @id @db.Uuid
  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  currency String @db.VarChar(3)
  estimatedRevenue Decimal @db.Decimal(16, 2)
  contractedRevenue Decimal @db.Decimal(16, 2)
  estimatedVendorCost Decimal @db.Decimal(16, 2)
  estimatedLabourCost Decimal @db.Decimal(16, 2)
  estimatedOtherDirectCost Decimal @db.Decimal(16, 2)
  recognitionPolicy String
  approvedBy String @db.Uuid
  approvedAt DateTime @default(now()) @db.Timestamptz(3)
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdditionalExpense {
  id String @id @default(uuid()) @db.Uuid
  weddingId String @db.Uuid
  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  weddingVendorId String? @db.Uuid
  weddingVendor WeddingVendor? @relation(fields: [weddingVendorId, weddingId], references: [id, weddingId], onDelete: Restrict)
  reference String
  kind String
  description String
  quantity Decimal @db.Decimal(12, 3)
  unitRate Decimal @db.Decimal(16, 2)
  taxRate Decimal @db.Decimal(5, 2)
  netAmount Decimal @db.Decimal(16, 2)
  taxAmount Decimal @db.Decimal(16, 2)
  total Decimal @db.Decimal(16, 2)
  clientCharge Decimal @db.Decimal(16, 2)
  currency String @db.VarChar(3)
  supportingDocumentId String? @db.Uuid
  supportingDocument Document? @relation(fields: [supportingDocumentId], references: [id], onDelete: Restrict)
  status ExpenseStatus @default(PENDING)
  requestedBy String @db.Uuid
  clientApprovedBy String? @db.Uuid
  clientApprovedAt DateTime? @db.Timestamptz(3)
  reviewedBy String? @db.Uuid
  reviewedAt DateTime? @db.Timestamptz(3)
  reviewNote String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([weddingId, reference])
  @@index([weddingVendorId, weddingId])
  @@index([weddingId, status])
}

model VendorBill {
  id String @id @default(uuid()) @db.Uuid
  weddingId String @db.Uuid
  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  weddingVendorId String @unique @db.Uuid
  weddingVendor WeddingVendor @relation(fields: [weddingVendorId, weddingId], references: [id, weddingId], onDelete: Restrict)
  reference String @unique
  amount Decimal @db.Decimal(16, 2)
  currency String @db.VarChar(3)
  dueAt DateTime @db.Timestamptz(3)
  documentId String? @db.Uuid
  document Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  submittedBy String @db.Uuid
  verifiedBy String? @db.Uuid
  verifiedAt DateTime? @db.Timestamptz(3)
  verificationNote String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([weddingId, dueAt])
  @@unique([weddingVendorId, weddingId])
}

model RevenueRecognition {
  id String @id @default(uuid()) @db.Uuid
  weddingId String @db.Uuid
  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  reference String
  amount Decimal @db.Decimal(16, 2)
  recognizedAt DateTime @db.Timestamptz(3)
  policy String
  note String
  postedBy String @db.Uuid
  reversedBy String? @db.Uuid
  reversedAt DateTime? @db.Timestamptz(3)
  reversalNote String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([weddingId, reference])
  @@index([weddingId, recognizedAt])
}

model ClientMilestone {
  id String @id @default(uuid()) @db.Uuid
  weddingId String @db.Uuid
  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  milestone PaymentMilestone
  amount Decimal @db.Decimal(16, 2)
  dueAt DateTime @db.Timestamptz(3)
  approvedBy String @db.Uuid
  approvedAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([weddingId, milestone])
  @@index([weddingId, dueAt])
}

model LabourRate {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  hourlyRate Decimal @db.Decimal(16, 2)
  currency String @db.VarChar(3)
  effectiveFrom DateTime @db.Timestamptz(3)
  approvedBy String @db.Uuid
  approvedAt DateTime @default(now()) @db.Timestamptz(3)
  entries LabourEntry[]
  @@unique([userId, currency, effectiveFrom])
}

model LabourEntry {
  id String @id @default(uuid()) @db.Uuid
  weddingId String @db.Uuid
  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  userId String @db.Uuid
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  rateId String @db.Uuid
  rate LabourRate @relation(fields: [rateId], references: [id], onDelete: Restrict)
  reference String
  workedAt DateTime @db.Timestamptz(3)
  hours Decimal @db.Decimal(8, 3)
  hourlyRate Decimal @db.Decimal(16, 2)
  cost Decimal @db.Decimal(16, 2)
  currency String @db.VarChar(3)
  status ExpenseStatus @default(PENDING)
  submittedBy String @db.Uuid
  reviewedBy String? @db.Uuid
  reviewedAt DateTime? @db.Timestamptz(3)
  reviewNote String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([weddingId, reference])
  @@index([rateId])
  @@index([userId, workedAt])
}

enum TaskStatus {
  TO_PLAN
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model TaskGeneration {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @unique @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  templateVersion String
  packageType PackageType
  dateBasis   DateTime @db.Date
  taskCount   Int
  createdBy   String @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  tasks       WeddingTask[]
  @@unique([id, weddingId])
}

model WeddingTask {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  generationId String @db.Uuid
  generation  TaskGeneration @relation(fields: [generationId, weddingId], references: [id, weddingId], onDelete: Restrict)
  templateKey String
  title       String
  description String
  category    String
  ownerId     String? @db.Uuid
  owner       UserProfile? @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  deadline    DateTime @db.Timestamptz(3)
  status      TaskStatus @default(TO_PLAN)
  priority    TaskPriority @default(NORMAL)
  functionId  String? @db.Uuid
  function    WeddingFunction? @relation(fields: [functionId, weddingId], references: [id, weddingId], onDelete: Restrict)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  @@unique([weddingId, templateKey])
  @@index([weddingId, status, deadline])
  @@index([ownerId])
  @@index([functionId, weddingId])
  @@index([generationId, weddingId])
}

model RateLimitBucket {
  key         String @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int
}

model Consultation {
  id           String @id @default(uuid()) @db.Uuid
  weddingId    String @db.Uuid
  wedding      Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  state        ConsultationState @default(REQUESTED)
  preferredAt  DateTime @db.Timestamptz(3)
  message      String?
  startAt      DateTime? @db.Timestamptz(3)
  endAt        DateTime? @db.Timestamptz(3)
  plannerId    String? @db.Uuid
  planner      UserProfile? @relation("Planner", fields: [plannerId], references: [id], onDelete: Restrict)
  internalNotes String?
  requestedBy  String @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  @@index([weddingId, createdAt])
  @@index([plannerId, startAt])
}

model AuditLog {
  id         String @id @default(uuid()) @db.Uuid
  actorId    String @db.Uuid
  action     String
  entityId   String @db.Uuid
  weddingId  String? @db.Uuid
  details    Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  @@index([weddingId, createdAt])
}

model IdempotencyRecord {
  actorId     String @db.Uuid
  key         String
  fingerprint String
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@id([actorId, key])
}
