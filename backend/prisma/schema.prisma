generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  FOUNDER
  PLANNER
  COORDINATOR
  FINANCE
  CLIENT
}

enum PackageType {
  FULL_SERVICE
  PARTIAL_DAY_OF
}

enum EnquiryStage {
  NEW
  CONTACTED
  CONSULTATION_SCHEDULED
  PROPOSAL_SENT
  LOST
}

enum WeddingState {
  ENQUIRY
  PROPOSAL
  AGREEMENT
  BOOKING_CONFIRMED
  PLANNING
  EXECUTION
  COMPLETED
  CANCELLED
}

enum ConsultationState {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model UserProfile {
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String
  role        Role
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  client      Client?
  assignments WeddingAssignment[]
  bookings    Consultation[] @relation("Planner")
  enquiries   Enquiry[]
}

model Client {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String   @unique
  phone       String?
  requirements String?
  userId      String?  @unique @db.Uuid
  archivedAt  DateTime? @db.Timestamptz(3)
  user        UserProfile? @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  weddings    WeddingClient[]
}

model Wedding {
  id            String       @id @default(uuid()) @db.Uuid
  title         String
  weddingDate   DateTime?     @db.Date
  packageType   PackageType
  state         WeddingState @default(ENQUIRY)
  guestCount    Int?
  preferredTheme String?
  coupleDetails String?
  location      String?
  requirements  String?
  currency      String @default("INR") @db.VarChar(3)
  budgetMax     Decimal?     @db.Decimal(16, 2)
  internalNotes String?
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  clients       WeddingClient[]
  assignments   WeddingAssignment[]
  enquiry       Enquiry?
  consultations Consultation[]
  functions     WeddingFunction[]
  agreement     Agreement?
  documents     Document[]
  quotationRounds QuotationRound[]
  vendors       WeddingVendor[]
  @@index([state, createdAt])
}

enum WeddingFunctionType {
  MEHENDI
  SANGEET
  RECEPTION
}

model WeddingFunction {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  type        WeddingFunctionType
  name        String
  startAt     DateTime? @db.Timestamptz(3)
  endAt       DateTime? @db.Timestamptz(3)
  venue       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  @@unique([weddingId, name])
  @@unique([id, weddingId])
}

model WeddingClient {
  weddingId String @db.Uuid
  clientId  String @db.Uuid
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  client    Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  @@id([weddingId, clientId])
  @@index([clientId])
}

model WeddingAssignment {
  weddingId String @db.Uuid
  userId    String @db.Uuid
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([weddingId, userId])
  @@index([userId])
}

model Enquiry {
  id            String @id @default(uuid()) @db.Uuid
  weddingId     String @unique @db.Uuid
  wedding       Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  stage         EnquiryStage @default(NEW)
  source        String?
  followUpStatus FollowUpStatus @default(PENDING)
  followUpAt    DateTime? @db.Timestamptz(3)
  assignedToId  String? @db.Uuid
  assignedTo    UserProfile? @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  internalNotes String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  @@index([stage, createdAt])
  @@index([assignedToId])
}

enum FollowUpStatus {
  PENDING
  CONTACTED
  FOLLOW_UP_DUE
  CLOSED
}

enum AgreementStatus {
  DRAFT
  SENT
  SIGNATURE_SUBMITTED
  SIGNED
}

enum DocumentKind {
  AGREEMENT
  SIGNED_AGREEMENT
  FLOOR_PLAN
  PAYMENT_EVIDENCE
}

enum DocumentStatus {
  PENDING
  VERIFIED
}

model Document {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  kind        DocumentKind
  status      DocumentStatus @default(PENDING)
  storagePath String @unique
  fileName    String
  contentType String
  size        Int
  sha256      String?
  uploadedBy  String @db.Uuid
  verifiedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  agreements  Agreement[] @relation("AgreementDocument")
  signatures  Agreement[] @relation("SignatureDocument")
  @@index([weddingId, kind])
}

model Agreement {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @unique @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  title       String
  terms       String
  version     Int @default(1)
  status      AgreementStatus @default(DRAFT)
  documentId  String? @db.Uuid
  document    Document? @relation("AgreementDocument", fields: [documentId], references: [id], onDelete: Restrict)
  signedDocumentId String? @db.Uuid
  signedDocument Document? @relation("SignatureDocument", fields: [signedDocumentId], references: [id], onDelete: Restrict)
  sentAt      DateTime? @db.Timestamptz(3)
  claimedSignedAt DateTime? @db.Timestamptz(3)
  signedAt    DateTime? @db.Timestamptz(3)
  verifiedBy  String? @db.Uuid
  verifiedAt  DateTime? @db.Timestamptz(3)
  reviewNote  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model VendorCategory {
  code        String @id
  name        String @unique
  vendors     Vendor[]
  rounds      QuotationRound[]
  selections  WeddingVendor[]
}

model Vendor {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  categoryCode String
  category    VendorCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  contactName String
  email       String @unique
  phone       String
  serviceDetails String
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  requests    QuotationRequest[]
  weddings    WeddingVendor[]
  @@index([categoryCode, name])
}

enum QuotationRoundStatus {
  OPEN
  SELECTED
}

enum QuotationRequestStatus {
  REQUESTED
  SUBMITTED
  SELECTED
  CLOSED
}

model QuotationRound {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  categoryCode String
  category    VendorCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  currency    String @db.VarChar(3)
  status      QuotationRoundStatus @default(OPEN)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  requests    QuotationRequest[]
  @@unique([weddingId, categoryCode])
}

model QuotationRequest {
  id          String @id @default(uuid()) @db.Uuid
  roundId     String @db.Uuid
  round       QuotationRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  vendorId    String @db.Uuid
  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status      QuotationRequestStatus @default(REQUESTED)
  closedAt    DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  quotation   Quotation?
  @@unique([roundId, vendorId])
}

model Quotation {
  id          String @id @default(uuid()) @db.Uuid
  requestId   String @unique @db.Uuid
  request     QuotationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  pricePerPlate Decimal @db.Decimal(16, 2)
  guestCount  Int
  additionalHourRate Decimal @db.Decimal(16, 2)
  additionalHours Decimal @db.Decimal(8, 2)
  menuDetails String
  inclusions  String[]
  exclusions  String[]
  total       Decimal @db.Decimal(16, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  items       QuotationItem[]
  selection   WeddingVendor?
}

model QuotationItem {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(16, 2)
  total       Decimal @db.Decimal(16, 2)
  @@index([quotationId])
}

model WeddingVendor {
  id          String @id @default(uuid()) @db.Uuid
  weddingId   String @db.Uuid
  wedding     Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  vendorId    String @db.Uuid
  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  categoryCode String
  category    VendorCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  quotationId String @unique @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@unique([weddingId, categoryCode])
  @@index([vendorId])
}

model RateLimitBucket {
  key         String @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int
}

model Consultation {
  id           String @id @default(uuid()) @db.Uuid
  weddingId    String @db.Uuid
  wedding      Wedding @relation(fields: [weddingId], references: [id], onDelete: Restrict)
  state        ConsultationState @default(REQUESTED)
  preferredAt  DateTime @db.Timestamptz(3)
  message      String?
  startAt      DateTime? @db.Timestamptz(3)
  endAt        DateTime? @db.Timestamptz(3)
  plannerId    String? @db.Uuid
  planner      UserProfile? @relation("Planner", fields: [plannerId], references: [id], onDelete: Restrict)
  internalNotes String?
  requestedBy  String @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  @@index([weddingId, createdAt])
  @@index([plannerId, startAt])
}

model AuditLog {
  id         String @id @default(uuid()) @db.Uuid
  actorId    String @db.Uuid
  action     String
  entityId   String @db.Uuid
  weddingId  String? @db.Uuid
  details    Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  @@index([weddingId, createdAt])
}

model IdempotencyRecord {
  actorId     String @db.Uuid
  key         String
  fingerprint String
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@id([actorId, key])
}
